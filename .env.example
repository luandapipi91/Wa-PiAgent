# WaPi 端口（可选，留空/删除用默认值）
WA_PI_WS_PORT=9776
WA_PI_WEB_PORT=5180

# 可选：开发环境独立数据目录（留给 start.bat/start.command 的浏览器版 dev）。
# 不设置则 dev 与打包版共享 ~/.pi/agent，会并发读写互相覆盖。设置后 dev 数据完全隔离。
# 支持 ${HOME} 插值（bun 解析 .env 时展开，macOS/Linux 下正确）；不要写 ~，Node 不展开 tilde。
# Windows（start.bat）下如 ${HOME} 为空，请显式写绝对路径，如 WA_PI_DIR=C:/Users/<user>/.pi/agent-dev。
# 用真实数据调试时删除/注释本行即可回到共享目录。
# WA_PI_DIR=${HOME}/.pi/agent-dev

# Cloudflare R2 发版凭证（仅本地 .env 填真实值，已 gitignore，勿提交）
# 发版：bun run --env-file=.env scripts/publish-oss.ts <version>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
