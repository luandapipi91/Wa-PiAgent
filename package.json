{
  "name": "hiagent",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:kernel": "bun run --filter @hiagent/kernel dev",
    "dev:frontend": "bun run --filter @hiagent/frontend dev",
    "test": "bun test",
    "typecheck": "bun run --filter '*' --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "^1.3.0"
  }
}
