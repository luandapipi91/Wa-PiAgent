{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "HiAgent 默认窗口权限：允许 shell plugin 执行 sidecar（kernel）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
