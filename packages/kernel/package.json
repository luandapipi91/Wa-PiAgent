{
  "name": "@hiagent/kernel",
  "version": "0.0.0",
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --target bun --outfile dist/hiagent-kernel && bun run scripts/copy-sidecar.mjs",
